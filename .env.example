APP_ENV=development
DEBUG=true
ENABLE_DEV_AUTH=false

POSTGRES_DB=victus_app
POSTGRES_USER=victus
POSTGRES_PASSWORD=victus
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_BASE_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=

SECRET_KEY=CHANGE_ME_GENERATED_BY_SCRIPT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# ES256 private key for the public David demo. Never add this value to the agent environment.
VICTUS_DEMO_JWT_PRIVATE_KEY_PEM=
# Preferred for Docker/Compose: base64-encoded PEM, with no line-break escaping.
VICTUS_DEMO_JWT_PRIVATE_KEY_PEM_BASE64=
VICTUS_DEMO_JWT_KID=demo-es256-2026-01
VICTUS_DEMO_JWT_ISSUER=victus-webapp
VICTUS_DEMO_JWT_TTL_SECONDS=30
# Shared only with the victus-agent container. It authorizes internal demo meal captures.
VICTUS_DEMO_AGENT_API_TOKEN=CHANGE_ME_GENERATED_BY_SCRIPT

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ENABLE_DB_CREATE_ALL=true

PHOENIX_TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=victus-local
PHOENIX_API_KEY=

OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false
OPENINFERENCE_HIDE_INPUT_MESSAGES=false
OPENINFERENCE_HIDE_OUTPUT_MESSAGES=false
