#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

create_env_if_missing() {
  if [[ -f .env ]]; then
    return
  fi

  cp .env.example .env
  local secret
  if command -v openssl >/dev/null 2>&1; then
    secret="$(openssl rand -hex 48)"
  else
    secret="$(python3 - <<'PY'
import secrets
print(secrets.token_hex(48))
PY
)"
  fi
  python3 - <<PY
from pathlib import Path
path = Path('.env')
text = path.read_text()
text = text.replace('CHANGE_ME_GENERATED_BY_SCRIPT', '$secret')
path.write_text(text)
PY
  echo "Created .env with a generated development SECRET_KEY."
}

compose() {
  docker compose --env-file .env "$@"
}

case "${1:-help}" in
  init)
    create_env_if_missing
    ;;
  up)
    create_env_if_missing
    compose up --build -d --remove-orphans
    echo "Victus WebApp is starting. Frontend: http://localhost:5173 · Backend: http://localhost:8000/health"
    ;;
  down)
    create_env_if_missing
    compose down
    ;;
  restart)
    create_env_if_missing
    compose down
    compose up --build -d --remove-orphans
    ;;
  rebuild)
    create_env_if_missing
    compose build --no-cache
    compose up -d --remove-orphans
    ;;
  logs)
    create_env_if_missing
    if [[ -n "${2:-}" ]]; then
      compose logs -f "$2"
    else
      compose logs -f
    fi
    ;;
  ps)
    create_env_if_missing
    compose ps
    ;;
  build)
    create_env_if_missing
    compose build
    ;;
  health)
    create_env_if_missing
    curl -fsS http://localhost:${BACKEND_PORT:-8000}/health || true
    echo
    ;;
  reset)
    create_env_if_missing
    compose down -v --remove-orphans
    echo "Removed containers and development volumes."
    ;;
  backend-shell)
    create_env_if_missing
    compose exec backend bash
    ;;
  db-shell)
    create_env_if_missing
    compose exec postgres psql -U "${POSTGRES_USER:-victus}" -d "${POSTGRES_DB:-victus_app}"
    ;;
  help|*)
    cat <<'HELP'
Victus WebApp scripts

Usage:
  ./scripts/victus init            Create .env for local development
  ./scripts/victus up              Build and start postgres, backend, frontend
  ./scripts/victus down            Stop services
  ./scripts/victus restart         Rebuild and restart services
  ./scripts/victus rebuild         Rebuild with --no-cache and restart
  ./scripts/victus logs [service]  Follow logs; service can be frontend/backend/postgres
  ./scripts/victus ps              Show service status
  ./scripts/victus health          Check backend health
  ./scripts/victus reset           Stop and delete development volumes
  ./scripts/victus backend-shell   Open shell in backend container
  ./scripts/victus db-shell        Open psql in postgres container
HELP
    ;;
esac
